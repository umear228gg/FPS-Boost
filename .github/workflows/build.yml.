name: Build UMEAR Mobile Boost

on:
  push:
    branches: [main, master]
  workflow_dispatch:

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Check and extract source ZIP
        id: locate
        shell: bash
        run: |
          test -f source.zip || { echo "Upload your project archive as source.zip to the repository root."; exit 1; }
          mkdir extracted
          unzip -q source.zip -d extracted
          BUILD_FILE="$(find extracted -name build.gradle -type f -print -quit)"
          test -n "$BUILD_FILE" || { echo "build.gradle was not found inside source.zip."; exit 1; }
          PROJECT_DIR="$(dirname "$BUILD_FILE")"
          echo "project_dir=$PROJECT_DIR" >> "$GITHUB_OUTPUT"

      - name: Set up Java 21
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "21"

      - name: Set up Gradle
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: "8.12.1"

      - name: Build JAR
        working-directory: ${{ steps.locate.outputs.project_dir }}
        run: gradle clean build --no-daemon

      - name: Upload JAR artifact
        uses: actions/upload-artifact@v4
        with:
          name: UMEAR-Mobile-Boost-1.21.4
          path: ${{ steps.locate.outputs.project_dir }}/build/libs/*.jar
          if-no-files-found: error
          retention-days: 14
